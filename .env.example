# blue-kakapo configuration — copy to `.env` and edit. Every value has a safe default; with none set,
# the platform runs in OFFLINE mode (no API key, no data leaves the host). Prefix: BK_

# --- deployment ---
# BK_DEPLOYMENT_NAME=blue-kakapo
# BK_DEFAULT_TENANT=default
# BK_DATA_DIR=./data

# --- storage ---
# BK_STORAGE_BACKEND=sqlite            # sqlite (dev) | postgres (prod)
# BK_DATABASE_URL=postgresql+psycopg://kakapo:kakapo@localhost:5432/kakapo

# --- LLM provider (pick one; default is offline) ---
# BK_PROVIDER=offline                  # offline | anthropic | openai | ollama
# BK_MODEL=offline-deterministic
# BK_EMBEDDING_MODEL=offline-embed
# BK_ANTHROPIC_API_KEY=
# BK_OPENAI_API_KEY=
# BK_OPENAI_BASE_URL=https://api.openai.com/v1
# BK_OLLAMA_BASE_URL=http://localhost:11434
# BK_LLM_TEMPERATURE=0.0

# --- memory (opt-in per case) ---
# BK_MEMORY_BACKEND=folder             # folder | pgvector | external
# BK_MEMORY_FOLDER=/path/to/case-memory

# --- guardian / safety ---
# BK_GUARDIAN_DEFAULT_DISPOSITION=ask  # never fail-open
# BK_MAX_CONCURRENT_ACTIONS=5
# BK_CONTAINMENT_DEFAULT_TTL_SECONDS=3600

# --- api ---
# BK_API_HOST=127.0.0.1
# BK_API_PORT=8713

# --- auth / rbac (enterprise; off by default for localhost) ---
# BK_AUTH_ENABLED=false
# BK_API_TOKENS=["svc-token:tenantA:analyst|responder"]   # static service tokens
# BK_OIDC_ISSUER=https://idp.example
# BK_OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
# BK_OIDC_AUDIENCE=blue-kakapo
# BK_OIDC_TENANT_CLAIM=tenant
# BK_OIDC_ROLES_CLAIM=roles

# --- secrets backend ---
# BK_SECRET_BACKEND=env                 # env | file | openbao
# BK_SECRET_FILE=/path/to/secrets.json
# BK_OPENBAO_ADDR=http://openbao:8200
# BK_OPENBAO_TOKEN=
# BK_OPENBAO_MOUNT=secret
# BK_SECRET_<NAME>=...                   # env backend: e.g. BK_SECRET_SPLUNK_TOKEN

# --- observability ---
# BK_LOG_LEVEL=INFO
# BK_LOG_JSON=false
# BK_OTEL_ENABLED=false
# BK_OTEL_ENDPOINT=
